# Environment
ENVIRONMENT=development

# MongoDB
MONGODB_URL=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/tutterfly_crm?retryWrites=true&w=majority
# For production, use: MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/tutterfly_crm
MONGODB_DB_NAME=tutterfly_crm

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=tutterfly-files
S3_PDF_BUCKET=tutterfly-pdfs

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
# Access token (minutes); refreshed silently against the 30-day refresh token.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Redis
REDIS_URL=redis://localhost:6379/0

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# OpenAI (for AI features)
OPENAI_API_KEY=your_openai_api_key

# Stripe (Billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# File Upload
MAX_FILE_SIZE=104857600

# Frontend URL — used by password-reset / verification emails. MUST be the
# real public URL in production, otherwise reset links point to localhost.
FRONTEND_URL=http://localhost:3000

# CORS — comma-separated list of allowed origins. Override in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:8000

# Sentry (optional). Leave empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Meta (WhatsApp / Messenger) webhook secrets — REQUIRED if /messaging/chatbot/webhook
# is exposed publicly. Without these, the endpoint returns 503.
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=

# PDF renderer callback signing key — required if /itineraries/pdf/callback is used.
PDF_CALLBACK_SECRET=
