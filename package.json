{
    "name": "tutterfly-root",
    "private": true,
    "workspaces": [
        "apps/frontend"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
        "dev:frontend": "npm run dev --workspace=apps/frontend",
        "dev:backend": "cd apps/backend && python -m uvicorn app.main:app --reload --port 8000",
        "install:all": "npm install && cd apps/backend && pip install -r requirements.txt",
        "codegen": "npm run generate-client --workspace=apps/frontend",
        "db:up": "docker-compose up -d"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    },
    "dependencies": {
        "node-fetch": "^2.7.0"
    }
}
